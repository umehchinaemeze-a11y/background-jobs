# =============================================================================
# Background job system — environment configuration
#
# Copy to `.env` and adjust. Never commit real secrets.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# Prisma-compatible URL. Local dev uses docker compose (see docker-compose.yml).
DATABASE_URL="postgresql://jobs:jobs@localhost:15435/jobs?schema=public"

# --- Job system operational settings ----------------------------------------
# Maximum number of attempts before a job is marked dead.
JOB_MAX_ATTEMPTS=5
# Maximum number of jobs a single worker may execute concurrently.
JOB_WORKER_CONCURRENCY=4
# Base exponential-backoff delay for the first retry (ms).
JOB_RETRY_BASE_DELAY_MS=2000
# Maximum random jitter added to a retry delay (ms).
JOB_RETRY_JITTER_MS=500
# Hard cap on a single retry delay; a safety bound against unbounded growth.
JOB_RETRY_MAX_DELAY_MS=300000
# A processing job older than this is considered stuck and is recovered (ms).
JOB_STUCK_TIMEOUT_MS=120000
# How long the worker sleeps between queue polls when idle (ms).
JOB_POLL_INTERVAL_MS=1500
# Hard ceiling on a single job execution attempt; exceeding it fails the attempt (ms).
JOB_WORK_TIMEOUT_MS=30000

# --- Email provider ----------------------------------------------------------
# `resend` = real Resend REST API. `test` = deterministic test adapter (never sends).
EMAIL_PROVIDER_VENDOR=resend
# Provider API key. MUST come from the environment, never from source code.
EMAIL_PROVIDER_API_KEY=
# From address used on every email.
EMAIL_PROVIDER_FROM="Acme Store <orders@example.com>"

# --- Test-only email controls ------------------------------------------------
# IGNORED unless EMAIL_PROVIDER_VENDOR=test.
# Forces every test-vendor send to throw (used to exercise failure/backoff/dead path).
TEST_FORCE_EMAIL_FAILURE=0
# Adds an artificial delay to test-vendor sends (ms).
TEST_EMAIL_DELAY_MS=0

# --- Minimal identity mechanism for this slice --------------------------------
# JSON object mapping userId -> bearer access token.
AUTH_USERS='{"alice":"tok_alice_dev","bob":"tok_bob_dev"}'

# --- Worker -------------------------------------------------------------------
# Optional stable identifier; default is auto-generated when empty.
WORKER_ID=

# --- Live-provider smoke test (scripts/breakit/07-resend-smoke.ts) ------------
# Recipient for REAL verification emails. Only read when EMAIL_PROVIDER_VENDOR=resend
# and EMAIL_PROVIDER_API_KEY is set; the break-it suite otherwise records a SKIP.
RESEND_SMOKE_TO=